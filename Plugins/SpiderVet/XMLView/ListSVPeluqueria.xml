<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <column name="Inicio" numcolumns="4" order="100">
            <widget type="datetime" fieldname="inicio" />
        </column>
        <column name="Paciente" numcolumns="6" order="110">
            <widget type="autocomplete" fieldname="idpaciente">
                <values source="sv_pacientes" fieldcode="id" fieldtitle="nombre" />
            </widget>
        </column>
        <column name="Encargado" numcolumns="4" order="120">
            <widget type="select" fieldname="responsable">
                <values source="users" fieldcode="nick" fieldtitle="nick" />
            </widget>
        </column>
        <column name="Estado" numcolumns="4" order="130">
            <widget type="select" fieldname="estado">
                <values title="En atención">borrador</values>
                <values title="Terminada">terminada</values>
            </widget>
        </column>
        <column name="Servicio solicitado" numcolumns="8" order="140">
            <widget type="textarea" fieldname="solicitado" rows="3" />
        </column>
        <column name="Servicio realizado" numcolumns="12" order="150">
            <widget type="textarea" fieldname="realizado" rows="3" />
        </column>
    </columns>
    <rows>
        <row type="status" fieldname="estado">
            <option color="warning" title="En atención">borrador</option>
            <option color="success" title="Terminada">terminada</option>
        </row>
    </rows>
</view>
