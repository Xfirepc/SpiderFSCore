<?xml version='1.0' encoding='UTF-8'?>
<view>
    <columns>
        <group name="cita" title="Cita" numcolumns="12">
            <column name="Paciente" numcolumns="6" order="100">
                <widget type="autocomplete" fieldname="idpaciente" required="true" onclick="EditSVPaciente">
                    <values source="sv_pacientes" fieldcode="id" fieldtitle="nombre" />
                </widget>
            </column>
            <column name="Servicio" numcolumns="6" order="110">
                <widget type="select" fieldname="servicio" required="true">
                    <values title="Veterinaria">veterinaria</values>
                    <values title="Peluquería">peluqueria</values>
                    <values title="Veterinaria y peluquería">ambos</values>
                </widget>
            </column>
            <column name="Inicio" numcolumns="4" order="120">
                <widget type="datetime" fieldname="inicio" required="true" />
            </column>
            <column name="Fin" numcolumns="4" order="130">
                <widget type="datetime" fieldname="fin" required="true" />
            </column>
            <column name="Profesional / encargado" numcolumns="4" order="140">
                <widget type="select" fieldname="responsable">
                    <values source="users" fieldcode="nick" fieldtitle="nick" />
                </widget>
            </column>
            <column name="Estado" numcolumns="4" order="150">
                <widget type="select" fieldname="estado" required="true">
                    <values title="Programada">programada</values>
                    <values title="Confirmada">confirmada</values>
                    <values title="Recibida">recibida</values>
                    <values title="Completada">completada</values>
                    <values title="Cancelada">cancelada</values>
                    <values title="No asistió">no_asistio</values>
                </widget>
            </column>
            <column name="Motivo" numcolumns="8" order="160">
                <widget type="textarea" fieldname="motivo" rows="3" />
            </column>
            <column name="Observaciones" numcolumns="12" order="170">
                <widget type="textarea" fieldname="observaciones" rows="3" />
            </column>
        </group>
    </columns>
</view>