<?xml version='1.0' encoding='UTF-8'?>
<view>
    <columns>
        <group name="prueba" title="7. Pruebas complementarias" numcolumns="12">
            <column name="Consulta" numcolumns="4" order="100">
                <widget type="autocomplete" fieldname="idconsulta" required="true" onclick="EditSVConsulta">
                    <values source="sv_consultas" fieldcode="id" fieldtitle="motivo" />
                </widget>
            </column>
            <column name="Fecha" numcolumns="4" order="110">
                <widget type="date" fieldname="fecha" required="true" />
            </column>
            <column name="Examen / procedimiento" numcolumns="12" order="120">
                <widget type="textarea" fieldname="examen" required="true" rows="3" />
            </column>
            <column name="Resultado / hallazgo" numcolumns="12" order="130">
                <widget type="textarea" fieldname="resultado" rows="3" />
            </column>
        </group>
    </columns>
</view>