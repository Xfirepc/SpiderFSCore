<?xml version='1.0' encoding='UTF-8'?>
<view>
    <columns>
        <group name="identificacion" title="Identificación y tutor" numcolumns="12">
            <column name="N.º de historia clínica" numcolumns="4" order="100">
                <widget type="text" fieldname="historia" readonly="true" maxlength="40" />
            </column>
            <column name="Tutor / cliente" numcolumns="8" order="110">
                <widget type="autocomplete" fieldname="codcliente" required="true" onclick="EditCliente">
                    <values source="clientes" fieldcode="codcliente" fieldtitle="nombre" />
                </widget>
            </column>
            <column name="Paciente activo" numcolumns="4" order="120">
                <widget type="checkbox" fieldname="activo" />
            </column>
        </group>
        <group name="paciente" title="Datos del paciente" numcolumns="12">
            <column name="Nombre" numcolumns="4" order="100">
                <widget type="text" fieldname="nombre" required="true" maxlength="100" />
            </column>
            <column name="Especie" numcolumns="4" order="110">
                <widget type="select" fieldname="especie" required="true">
                    <values title="Canino">canino</values>
                    <values title="Felino">felino</values>
                    <values title="Otro">otro</values>
                </widget>
            </column>
            <column name="Otra especie" numcolumns="4" order="120">
                <widget type="text" fieldname="otraespecie" />
            </column>
            <column name="Raza" numcolumns="4" order="130">
                <widget type="text" fieldname="raza" />
            </column>
            <column name="Sexo" numcolumns="4" order="140">
                <widget type="select" fieldname="sexo">
                    <values title="Macho">macho</values>
                    <values title="Hembra">hembra</values>
                    <values title="Desconocido">desconocido</values>
                </widget>
            </column>
            <column name="Fecha de nacimiento" numcolumns="4" order="150">
                <widget type="date" fieldname="nacimiento" />
            </column>
            <column name="Edad estimada (si no se conoce el nacimiento)" numcolumns="4" order="160">
                <widget type="text" fieldname="edadestimada" />
            </column>
            <column name="Color / señas" numcolumns="8" order="170">
                <widget type="textarea" fieldname="color" rows="3" />
            </column>
            <column name="Peso (kg)" numcolumns="4" order="180">
                <widget type="number" fieldname="peso" min="0" decimal="2" />
            </column>
            <column name="Condición reproductiva" numcolumns="4" order="190">
                <widget type="select" fieldname="reproductiva">
                    <values title="Entero/a">entero</values>
                    <values title="Esterilizado/a">esterilizado</values>
                    <values title="Desconocida">desconocida</values>
                </widget>
            </column>
            <column name="Microchip" numcolumns="4" order="200">
                <widget type="text" fieldname="microchip" maxlength="60" />
            </column>
            <column name="Hábitat" numcolumns="4" order="210">
                <widget type="select" fieldname="habitat">
                    <values title="Interior">interior</values>
                    <values title="Exterior">exterior</values>
                    <values title="Mixto">mixto</values>
                    <values title="Desconocido">desconocido</values>
                </widget>
            </column>
        </group>
        <group name="antecedentes" title="Antecedentes" numcolumns="12">
            <column name="Vacunación" numcolumns="4" order="100">
                <widget type="select" fieldname="vacunacion">
                    <values title="Completa">completa</values>
                    <values title="Incompleta">incompleta</values>
                    <values title="Desconocida">desconocida</values>
                </widget>
            </column>
            <column name="Última vacunación" numcolumns="4" order="110">
                <widget type="date" fieldname="ultimavacuna" />
            </column>
            <column name="Desparasitación" numcolumns="4" order="120">
                <widget type="select" fieldname="desparasitacion">
                    <values title="Interna">interna</values>
                    <values title="Externa">externa</values>
                    <values title="Interna y externa">ambas</values>
                    <values title="Desconocida">desconocida</values>
                </widget>
            </column>
            <column name="Última desparasitación" numcolumns="4" order="130">
                <widget type="date" fieldname="ultimadesparasitacion" />
            </column>
            <column name="Alimentación" numcolumns="8" order="140">
                <widget type="textarea" fieldname="alimentacion" rows="3" />
            </column>
            <column name="Alergias / RAM" numcolumns="6" order="150">
                <widget type="textarea" fieldname="alergias" rows="3" />
            </column>
            <column name="Medicamentos actuales" numcolumns="6" order="160">
                <widget type="textarea" fieldname="medicamentos" rows="3" />
            </column>
            <column name="Antecedentes médicos / quirúrgicos" numcolumns="12" order="170">
                <widget type="textarea" fieldname="antecedentes" rows="3" />
            </column>
        </group>
        <group name="bano" title="Indicaciones de baño y manejo" numcolumns="12">
            <column name="Cómo tratar a la mascota durante el baño" numcolumns="12" order="100">
                <widget type="textarea" fieldname="indicacionesbano" rows="3" />
            </column>
            <column name="Observaciones generales" numcolumns="12" order="110">
                <widget type="textarea" fieldname="observaciones" rows="3" />
            </column>
        </group>
    </columns>
</view>