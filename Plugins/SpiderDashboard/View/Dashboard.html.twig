{% extends 'Master/MenuBghTemplate.html.twig' %}

{% block body %}
<main id="spider-dashboard" class="spider-dashboard" data-endpoint="{{ asset(fsc.url()) }}">
    <header class="dash-header">
        <div>
            <div class="dash-eyebrow"><span class="dash-live-dot"></span> PANEL DE NEGOCIO</div>
            <h1>Mi negocio<span class="dash-heading-dot">.</span></h1>
            <p class="dash-subtitle">{{ fsc.empresa.nombrecorto }} <span aria-hidden="true">/</span> Los números que te ayudan a decidir.</p>
        </div>
        <div class="dash-header-actions">
            <span class="dash-updated" id="dash-updated" aria-live="polite">Datos al {{ fsc.dashboardToday|date('d/m/Y') }}</span>
            <button type="button" class="dash-button dash-button-quiet" id="dash-refresh"><i class="fas fa-sync-alt" aria-hidden="true"></i> Actualizar</button>
            <a class="dash-button dash-bookmark" href="{{ asset(fsc.url()) }}?defaultPage={{ fsc.user.homepage == 'Dashboard' ? 'FALSE' : 'TRUE' }}"
               title="{{ fsc.user.homepage == 'Dashboard' ? 'Quitar como página de inicio' : 'Usar como página de inicio' }}"
               aria-label="{{ fsc.user.homepage == 'Dashboard' ? 'Quitar como página de inicio' : 'Usar como página de inicio' }}">
                <i class="{{ fsc.user.homepage == 'Dashboard' ? 'fas' : 'far' }} fa-bookmark" aria-hidden="true"></i>
            </a>
        </div>
    </header>

    <form class="dash-filters" id="dash-filter-form" method="get" action="{{ asset(fsc.url()) }}">
        <div class="dash-field dash-period-field">
            <label for="dash-period">Período de análisis</label>
            <select id="dash-period" class="dash-input">
                <option value="custom">Personalizado</option>
                <option value="today">Hoy</option>
                <option value="week">Últimos 7 días</option>
                <option value="month" selected>Este mes</option>
                <option value="year">Este año</option>
            </select>
        </div>
        <div class="dash-field"><label for="dash-from">Desde</label><input class="dash-input" type="date" id="dash-from" name="from" value="{{ fsc.filters.from }}" required></div>
        <span class="dash-date-separator" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
        <div class="dash-field"><label for="dash-to">Hasta</label><input class="dash-input" type="date" id="dash-to" name="to" value="{{ fsc.filters.to }}" required></div>
        <div class="dash-field dash-warehouse-field">
            <label id="dash-warehouse-title">Almacenes</label>
            <details class="dash-picker" id="dash-warehouse-picker">
                <summary aria-labelledby="dash-warehouse-title dash-warehouse-label"><span id="dash-warehouse-label">Todos los almacenes</span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
                <div class="dash-picker-menu">
                    <button type="button" class="dash-all-warehouses" id="dash-all-warehouses">Ver todos los almacenes</button>
                    {% for warehouse in fsc.warehouses %}
                        <label class="dash-checkbox"><input type="checkbox" name="warehouses[]" value="{{ warehouse.codalmacen }}" {% if warehouse.codalmacen in fsc.filters.warehouses %}checked{% endif %}>
                            <span>{{ warehouse.nombre }} <small>{{ warehouse.codalmacen }}{% if not warehouse.activo %} · Inactivo{% endif %}</small></span>
                        </label>
                    {% else %}
                        <p class="dash-muted">No hay almacenes disponibles.</p>
                    {% endfor %}
                </div>
            </details>
        </div>
        <button type="submit" class="dash-button dash-button-primary"><i class="fas fa-sliders-h" aria-hidden="true"></i> Aplicar</button>
        <span class="dash-currency">USD <span aria-hidden="true">·</span> Ecuador</span>
    </form>

    <nav class="dash-tabs" role="tablist" aria-label="Secciones del negocio">
        {% set icons = {summary: 'th-large', sales: 'chart-line', receivables: 'file-invoice-dollar', inventory: 'boxes-stacked', cash: 'cash-register', ebilling: 'shield-alt'} %}
        {% for key, label in fsc.sections %}
            <button type="button" role="tab" class="dash-tab{{ fsc.filters.section == key ? ' is-active' : '' }}" id="dash-tab-{{ key }}"
                    data-section="{{ key }}" aria-selected="{{ fsc.filters.section == key ? 'true' : 'false' }}" aria-controls="dash-content" tabindex="{{ fsc.filters.section == key ? '0' : '-1' }}">
                <i class="fas fa-{{ icons[key] }}" aria-hidden="true"></i><span>{{ label }}</span>
            </button>
        {% endfor %}
    </nav>
    <div id="dash-message" class="dash-message" role="status" aria-live="polite" {% if not fsc.dashboardError %}hidden{% endif %}>{{ fsc.dashboardError }}</div>
    <div id="dash-content" class="dash-content" role="tabpanel" aria-labelledby="dash-tab-{{ fsc.filters.section }}" aria-busy="false">
        <div class="dash-loading"><span class="dash-spinner"></span> Preparando la información de tu negocio…</div>
    </div>
    <noscript><div class="dash-message">Activa JavaScript para consultar los gráficos y las secciones de tu negocio.</div></noscript>
    <footer class="dash-footer"><span><i class="fas fa-lock" aria-hidden="true"></i> Información según los permisos de tu usuario.</span><span>Ventas y cierres por período · Cartera, stock y comprobantes al día.</span></footer>
</main>
{% set dashboardState = {filters: fsc.filters, sections: fsc.sections, data: fsc.initialData, today: fsc.dashboardToday, token: fsc.multiRequestProtection.newToken(), error: fsc.dashboardError} %}
<script type="application/json" id="dash-initial-data">{{ dashboardState|json_encode(15)|raw }}</script>
{% endblock %}
